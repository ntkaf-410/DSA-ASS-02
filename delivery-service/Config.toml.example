# Local settings for docker-compose.dev.yml.
# Copy to Config.toml; Config.toml is git-ignored.

servicePort = 8085

dbHost = "localhost"
dbPort = 3310
dbUser = "root"
dbPassword = "root"
dbName = "delivery_db"

kafkaBootstrap = "localhost:9092"
consumerGroupId = "delivery-service-group"
orderCreatedTopic = "orders.created"
orderStatusTopic = "orders.status.changed"
driverAssignedTopic = "deliveries.driver.assigned"
deliveryStatusTopic = "deliveries.status.changed"
driverLocationTopic = "deliveries.location.updated"

maxAssignAttempts = 5
