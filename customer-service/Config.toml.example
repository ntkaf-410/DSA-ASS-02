# Copy to Config.toml for local runs (Config.toml is git-ignored).
# In Docker, use env vars instead, e.g. BAL_CONFIG_VAR_DBHOST=mysql

servicePort = 8081

dbHost = "localhost"
dbPort = 3306
dbUser = "root"
dbPassword = "root"
dbName = "customer_db"

kafkaBootstrap = "localhost:9092"
consumerGroupId = "customer-service-group"
customerRegisteredTopic = "customers.registered"
orderCreatedTopic = "orders.created"
orderStatusTopic = "orders.status.changed"
