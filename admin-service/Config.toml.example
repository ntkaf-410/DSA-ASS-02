# Copy to Config.toml for local runs (Config.toml is git-ignored).
# In Docker use env vars instead, e.g. BAL_CONFIG_VAR_DBHOST=mysql

servicePort = 8087

dbHost = "localhost"
dbPort = 3312
dbUser = "root"
dbPassword = "root"
dbName = "admin_db"

kafkaBootstrap = "localhost:9092"
consumerGroupId = "admin-service-group"

customerServiceUrl = "http://localhost:8081"
restaurantServiceUrl = "http://localhost:8082"
orderServiceUrl = "http://localhost:8083"
paymentServiceUrl = "http://localhost:8084"
deliveryServiceUrl = "http://localhost:8085"
notificationServiceUrl = "http://localhost:8086"
