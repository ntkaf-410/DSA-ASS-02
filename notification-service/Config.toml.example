# Local settings for docker-compose.dev.yml.
# Copy to Config.toml; Config.toml is git-ignored.

servicePort = 8086

dbHost = "localhost"
dbPort = 3311
dbUser = "root"
dbPassword = "root"
dbName = "notification_db"

kafkaBootstrap = "localhost:9092"
consumerGroupId = "notification-service-group"
customerRegisteredTopic = "customers.registered"
orderCreatedTopic = "orders.created"
orderStatusTopic = "orders.status.changed"
paymentCompletedTopic = "payments.completed"
paymentFailedTopic = "payments.failed"
lowStockTopic = "restaurants.stock.low"
driverAssignedTopic = "deliveries.driver.assigned"
deliveryStatusTopic = "deliveries.status.changed"

customerServiceUrl = "http://localhost:8081"
